# Backend API URL
# Local: http://localhost:8000
# Production: your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend configuration
# Local Development - SQLite in project directory
DATABASE_URL=sqlite:///./duolingo_clone.db

# Production on Render - use persistent disk at /var/data
# DATABASE_URL=sqlite:////var/data/duolingo_clone.db

# Frontend URL (for backend CORS)
FRONTEND_URL=http://localhost:3000
